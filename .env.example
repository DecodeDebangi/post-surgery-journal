# Neon Postgres connection string (Neon console → Connect → pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# A separate Neon branch used only by `npm test` (its tables get wiped)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# bcrypt hashes of the two 6-digit PINs. Make each with: npm run hash-pin
# Keep the single quotes: the hashes contain "$" characters.
SITE_PIN_HASH='$2b$12$replace-me'
DOCTOR_PIN_HASH='$2b$12$replace-me'

# Surgery day (Day 0) and the time zone that decides what "today" is
SURGERY_DATE=2026-08-15
TIMEZONE=Asia/Kolkata

PORT=3001

# Neon Object Storage for photos (optional; without it, photo upload is switched off).
# Neon console → Storage: create a private bucket, then a credential with storage:read + storage:write.
STORAGE_ENDPOINT=https://br-xxxx.storage.c-4.REGION.aws.neon.tech
TEST_STORAGE_ENDPOINT=https://br-yyyy.storage.c-4.REGION.aws.neon.tech
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=media
STORAGE_ACCESS_KEY_ID=nak_live_...
STORAGE_SECRET_ACCESS_KEY=nsk_live_...
